<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Redirections, Safe Browsing, liste DNS -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Scan de toutes les applis installées (anti-spy) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Alertes -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Détection des SMS d'arnaque -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Surveillance micro / caméra -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Traqueurs Bluetooth -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Photo de l'intrus -->
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Détection du renvoi d'appels -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Déverrouillage par empreinte / visage -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".MiradorApp"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Intercepte chaque lien ouvert sur le téléphone (quand Mirador est le navigateur par défaut) -->
        <activity
            android:name=".MiradorActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Mirador – Vérification"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- "Partager" un lien vers Mirador depuis n'importe quelle appli -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity android:name=".ScanActivity" android:exported="false" android:label="Scan anti-spy" />
        <activity android:name=".SmsScanActivity" android:exported="false" android:label="SMS d'arnaque" />
        <activity android:name=".DnsActivity" android:exported="false" android:label="Filtre DNS" />
        <activity android:name=".SensorLogActivity" android:exported="false" android:label="Micro &amp; caméra" />
        <activity android:name=".SettingsActivity" android:exported="false" android:label="Réglages" />
        <activity android:name=".DataUsageActivity" android:exported="false" android:label="Données envoyées" />
        <activity android:name=".PermissionsActivity" android:exported="false" android:label="Permissions" />
        <activity android:name=".PwnedActivity" android:exported="false" android:label="Mot de passe piraté ?" />
        <activity android:name=".TrackerActivity" android:exported="false" android:label="Traqueurs Bluetooth" />
        <activity android:name=".CallForwardActivity" android:exported="false" android:label="Renvoi d'appels" />
        <activity android:name=".OnboardingActivity" android:exported="false" android:label="Mirador" />
        <activity android:name=".GuideActivity" android:exported="false" android:label="Je pense être espionné(e)" />
        <!-- « Ouvrir avec Mirador » depuis un gestionnaire de fichiers pour vérifier un APK -->
        <activity
            android:name=".ApkCheckActivity"
            android:exported="true"
            android:label="Analyser l'APK avec Mirador">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
        </activity>

        <!-- Analyse des messages WhatsApp, Messenger… (via leurs notifications) -->
        <service
            android:name=".MessageGuardService"
            android:exported="true"
            android:label="Mirador – messages suspects"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Boutons des réglages rapides -->
        <service
            android:name=".ScanTile"
            android:exported="true"
            android:icon="@drawable/ic_shield"
            android:label="Scan anti-spy"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".DnsTile"
            android:exported="true"
            android:icon="@drawable/ic_shield"
            android:label="Filtre DNS"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Protection contre la désinstallation -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:label="Mirador – anti-désinstallation"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Widget d'écran d'accueil -->
        <receiver
            android:name=".StatusWidget"
            android:exported="true"
            android:label="Mirador">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Vérification automatique toutes les ~15 min -->
        <service
            android:name=".WatchJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Filtre DNS (VPN local) -->
        <service
            android:name=".DnsVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Journal micro / caméra -->
        <service
            android:name=".SensorMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Journal de sécurité des accès au micro et à la caméra" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
